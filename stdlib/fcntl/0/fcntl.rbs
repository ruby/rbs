# <!-- rdoc-file=ext/fcntl/fcntl.c -->
# Fcntl loads the constants defined in the system's <fcntl.h> C header file, and
# used with both the fcntl(2) and open(2) POSIX system calls.
#
# To perform a fcntl(2) operation, use IO::fcntl.
#
# To perform an open(2) operation, use IO::sysopen.
#
# The set of operations and constants available depends upon specific operating
# system.  Some values listed below may not be supported on your system.
#
# See your fcntl(2) man page for complete details.
#
# Open /tmp/tempfile as a write-only file that is created if it doesn't exist:
#
#     require 'fcntl'
#
#     fd = IO.sysopen('/tmp/tempfile',
#                     Fcntl::O_WRONLY | Fcntl::O_EXCL | Fcntl::O_CREAT)
#     f = IO.open(fd)
#     f.syswrite("TEMP DATA")
#     f.close
#
# Get the flags on file `s`:
#
#     m = s.fcntl(Fcntl::F_GETFL, 0)
#
# Set the non-blocking flag on `f` in addition to the existing flags in `m`.
#
#     f.fcntl(Fcntl::F_SETFL, Fcntl::O_NONBLOCK|m)
#
module Fcntl
  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # The version string.
  #
  VERSION: String

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Duplicate a file descriptor to the minimum unused file descriptor greater than
  # or equal to the argument.
  #
  # The close-on-exec flag of the duplicated file descriptor is set. (Ruby uses
  # F_DUPFD_CLOEXEC internally if available to avoid race condition.  F_SETFD is
  # used if F_DUPFD_CLOEXEC is not available.)
  #
  F_DUPFD: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Read the close-on-exec flag of a file descriptor.
  #
  F_GETFD: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Determine whether a given region of a file is locked.  This uses one of the
  # F_*LK flags.
  #
  F_GETLK: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Set the close-on-exec flag of a file descriptor.
  #
  F_SETFD: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Get the file descriptor flags.  This will be one or more of the O_* flags.
  #
  F_GETFL: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Set the file descriptor flags.  This will be one or more of the O_* flags.
  #
  F_SETFL: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Acquire a lock on a region of a file.  This uses one of the F_*LCK flags.
  #
  F_SETLK: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Acquire a lock on a region of a file, waiting if necessary.  This uses one of
  # the F_*LCK flags
  #
  F_SETLKW: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # the value of the close-on-exec flag.
  #
  FD_CLOEXEC: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Read lock for a region of a file
  #
  F_RDLCK: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Remove lock for a region of a file
  #
  F_UNLCK: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Write lock for a region of a file
  #
  F_WRLCK: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Change the capacity of the pipe referred to by fd to be at least arg bytes.
  #
  F_SETPIPE_SZ: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Return (as the function result) the capacity of the pipe referred to by fd.
  #
  F_GETPIPE_SZ: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Create the file if it doesn't exist
  #
  O_CREAT: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Used with O_CREAT, fail if the file exists
  #
  O_EXCL: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Open TTY without it becoming the controlling TTY
  #
  O_NOCTTY: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Truncate the file on open
  #
  O_TRUNC: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Open the file in append mode
  #
  O_APPEND: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Open the file in non-blocking mode
  #
  O_NONBLOCK: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Open the file in non-blocking mode
  #
  O_NDELAY: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Open the file in read-only mode
  #
  O_RDONLY: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Open the file in read-write mode
  #
  O_RDWR: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Open the file in write-only mode.
  #
  O_WRONLY: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # Mask to extract the read/write flags
  #
  O_ACCMODE: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # It is a FreeBSD specific constant and equivalent to dup2 call.
  #
  F_DUP2FD: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # It is a FreeBSD specific constant and acts similarly as F_DUP2FD but set the
  # FD_CLOEXEC flag in addition.
  #
  F_DUP2FD_CLOEXEC: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # macOS specific flag used for preallocating file space.
  #
  F_PREALLOCATE: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # macOS specific flag used with F_PREALLOCATE for allocating contiguous space.
  #
  F_ALLOCATECONTIG: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # macOS specific flag used with F_PREALLOCATE for allocating all contiguous
  # space or no space.
  #
  F_ALLOCATEALL: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # macOS specific flag used with F_PREALLOCATE. Allocate space that is not freed
  # when close is called.
  #
  F_ALLOCATEPERSIST: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # macOS specific flag used with F_PREALLOCATE. Allocate from the physical end of
  # file
  #
  F_PEOFPOSMODE: Integer

  # <!-- rdoc-file=ext/fcntl/fcntl.c -->
  # macOS specific flag used with F_PREALLOCATE. Allocate from the volume offset.
  #
  F_VOLPOSMODE: Integer
end
