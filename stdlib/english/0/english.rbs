# Descriptive aliases of the special global variables, defined by
# `require "English"`.
#
# Each alias has the same type as its original variable in
# core/global_variables.rbs.

# The exception object passed to +raise+.
# Alias of <code>$!</code>.
$ERROR_INFO: Exception?

# The stack backtrace generated by the last
# exception. See Kernel#caller for details. Thread local.
# Alias of <code>$@</code>.
$ERROR_POSITION: Array[String]?

# The default separator pattern used by String#split.  May be set from
# the command line using the <code>-F</code> flag.
# Alias of <code>$;</code>.
$FS: Regexp | String | nil

# The default separator pattern used by String#split.  May be set from
# the command line using the <code>-F</code> flag.
# Alias of <code>$;</code>.
$FIELD_SEPARATOR: Regexp | String | nil

# The separator string output between the parameters to methods such
# as Kernel#print and Array#join. Defaults to +nil+, which adds no
# text.
# Alias of <code>$,</code>.
$OFS: String?

# The separator string output between the parameters to methods such
# as Kernel#print and Array#join. Defaults to +nil+, which adds no
# text.
# Alias of <code>$,</code>.
$OUTPUT_FIELD_SEPARATOR: String?

# The input record separator (newline by default). This is the value
# that routines such as Kernel#gets use to determine record
# boundaries. If set to +nil+, +gets+ will read the entire file.
# Alias of <code>$/</code>.
$RS: String?

# The input record separator (newline by default). This is the value
# that routines such as Kernel#gets use to determine record
# boundaries. If set to +nil+, +gets+ will read the entire file.
# Alias of <code>$/</code>.
$INPUT_RECORD_SEPARATOR: String?

# The string appended to the output of every call to methods such as
# Kernel#print and IO#write. The default value is +nil+.
# Alias of <code>$\</code>.
$ORS: String?

# The string appended to the output of every call to methods such as
# Kernel#print and IO#write. The default value is +nil+.
# Alias of <code>$\</code>.
$OUTPUT_RECORD_SEPARATOR: String?

# The number of the last line read from the current input file.
# Alias of <code>$.</code>.
$NR: Integer

# The number of the last line read from the current input file.
# Alias of <code>$.</code>.
$INPUT_LINE_NUMBER: Integer

# The last line read by Kernel#gets or
# Kernel#readline. Many string-related functions in the
# Kernel module operate on <code>$_</code> by default. The variable is
# local to the current scope. Thread local.
# Alias of <code>$_</code>.
$LAST_READ_LINE: String?

# The destination of output for Kernel#print
# and Kernel#printf. The default value is
# <code>$stdout</code>.
# Alias of <code>$></code>.
$DEFAULT_OUTPUT: IO

# An object that provides access to the concatenation
# of the contents of all the files
# given as command-line arguments, or <code>$stdin</code>
# (in the case where there are no
# arguments). Read only.
# Alias of <code>$<</code>.
$DEFAULT_INPUT: RBS::Unnamed::ARGFClass

# The process number of the program being executed. Read only.
# Alias of <code>$$</code>.
$PID: Integer

# The process number of the program being executed. Read only.
# Alias of <code>$$</code>.
$PROCESS_ID: Integer

# The exit status of the last child process to terminate. Read
# only. Thread local.
# Alias of <code>$?</code>.
$CHILD_STATUS: Process::Status?

# A +MatchData+ object that encapsulates the results of a successful
# pattern match. The variables <code>$&</code>, <code>$`</code>, <code>$'</code>,
# and <code>$1</code> to <code>$9</code> are all derived from
# <code>$~</code>. Assigning to <code>$~</code> changes the values of these
# derived variables.  This variable is local to the current
# scope.
# Alias of <code>$~</code>.
$LAST_MATCH_INFO: MatchData?

# An array of strings containing the command-line
# options from the invocation of the program. Options
# used by the Ruby interpreter will have been
# removed. Read only. Also known simply as +ARGV+.
# Alias of <code>$*</code>.
$ARGV: Array[String]

# The string matched by the last successful pattern
# match. This variable is local to the current
# scope. Read only.
# Alias of <code>$&</code>.
$MATCH: String?

# The string preceding the match in the last
# successful pattern match. This variable is local to
# the current scope. Read only.
# Alias of <code>$`</code>.
$PREMATCH: String?

# The string following the match in the last
# successful pattern match. This variable is local to
# the current scope. Read only.
# Alias of <code>$'</code>.
$POSTMATCH: String?

# The contents of the highest-numbered group matched in the last
# successful pattern match. Thus, in <code>"cat" =~ /(c|a)(t|z)/</code>,
# <code>$+</code> will be set to "t".  This variable is local to the
# current scope. Read only.
# Alias of <code>$+</code>.
$LAST_PAREN_MATCH: String?
