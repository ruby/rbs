module RBS
  class Environment
    # The dependencies of the type name resolution of each source of an environment
    #
    # The resolution of the type names of a source changes only if a type name it tested is added, removed, or declared
    # as another class/module alias. Recording the dependencies with `Environment#resolve_type_names` allows updating
    # a resolved environment incrementally: after some sources are removed from and added to the environment,
    # `#affected_paths` tells the other sources whose type names may be resolved differently, and only those sources
    # have to be resolved again with the added ones.
    #
    # ```ruby
    # dependencies = RBS::Environment::TypeNameDependencies.new
    # env = env.resolve_type_names(dependencies: dependencies)
    #
    # new_env = env.unload(Set[path])
    # new_env.add_source(source)
    #
    # dependencies.affected_paths(env, new_env, except: Set[path]).each do |path|
    #   # Replace the source of `path` in `new_env` with the one before the type name resolution
    # end
    #
    # new_env = new_env.resolve_type_names(only: declarations, dependencies: dependencies)
    # ```
    #
    # The keys are the names of the buffers of the sources.
    #
    class TypeNameDependencies
      interface _Empty
        def empty?: () -> bool
      end

      # The resolver for the resolution of a source, that records the type names tested for the source
      #
      class Recorder
        include Resolver::_TypeNameResolver

        @resolver: Resolver::TypeNameResolver

        # The arrays of type names `TypeNameResolver#resolve_with_dependencies` returned
        #
        # The resolutions of the same type name in the same context return the same array.
        #
        @dependencies: Array[Array[TypeName]]

        def initialize: (Resolver::TypeNameResolver resolver) -> void

        # Returns the type names tested for the resolutions so far
        #
        def type_names: () -> Set[TypeName]
      end

      # The type names tested while resolving the type names of each source
      #
      # The names include the ones that don't exist. A source without type names to resolve has no entry.
      #
      attr_reader type_names: Hash[Pathname, Set[TypeName]]

      # The namespaces of the wildcard `use` directives of each source
      #
      # A wildcard `use` directive depends on the set of the type names directly under its namespace. A source without
      # the directives has no entry.
      #
      attr_reader namespaces: Hash[Pathname, Set[Namespace]]

      def initialize: () -> void

      # The copy has its own hashes, and shares the sets
      #
      def initialize_copy: (TypeNameDependencies other) -> void

      # Returns the resolver to resolve the sources of `env`
      #
      # The resolver reads the names of the modules of class/module aliases before the resolution, that the
      # declarations have as `unresolved_old_name`. The declaration of an alias in a resolved source has the resolved
      # name of the module, and a resolver that reads it tests other type names than a resolver that reads the
      # declaration before the resolution. A source is resolved in the same way, with the same dependencies, whether
      # the sources of the aliases are resolved or not.
      #
      # The dependencies of the sources that have no declaration, and of the sources `env` doesn't have, are deleted.
      #
      def resolver: (Environment env) -> Resolver::TypeNameResolver

      # Yields a resolver to resolve the type names of the source with, and records the dependencies of the source
      #
      # The dependencies of the source are replaced, or added to the ones it has if `merge` is `true`.
      #
      # Returns the value of the block.
      #
      def record: [T] (Source::t source, Resolver::TypeNameResolver resolver, merge: bool) { (Resolver::_TypeNameResolver) -> T } -> T

      # Deletes the dependencies of the source
      #
      def delete: (Pathname path) -> void

      # Deletes the dependencies of the sources that are not included in `paths`
      #
      def keep: (Set[Pathname] paths) -> void

      # Returns the paths of the sources whose type names may be resolved differently in `new_env`
      #
      # `old_env` is the environment the dependencies were recorded with, and `new_env` has the sources after an update:
      # `old_env.unload(except)` and `#add_source`. `except` is the paths of the updated sources, that are not included
      # in the result.
      #
      # A source is included if a type name it tested is one of `#changed_type_names`, or a type name is added to or
      # removed from the namespace of its wildcard `use` directive.
      #
      def affected_paths: (Environment old_env, Environment new_env, except: Set[Pathname]) -> Set[Pathname]

      # Returns the type names that the dependencies of sources are compared with
      #
      # * The names of classes, modules, class/module aliases, interfaces, and type aliases that only one of the environments has
      # * The names of class/module aliases that are declared differently, in the name of the module before the resolution or in the context
      #
      # The names are compared for each kind, because a class that is replaced with a class alias of the same name changes
      # the resolution.
      #
      def changed_type_names: (Environment old_env, Environment new_env) -> Set[TypeName]

      private

      # Sets the dependencies of the source, or deletes the entry if the value is empty
      #
      def update: [T < _Empty] (Hash[Pathname, T] hash, Pathname path, T value) -> void

      # Adds the keys that only one of the hashes has to `names`
      #
      def add_changed_keys: (Hash[TypeName, untyped] old_decls, Hash[TypeName, untyped] new_decls, Set[TypeName] names) -> void
    end
  end
end
