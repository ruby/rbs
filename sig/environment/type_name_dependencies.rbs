module RBS
  class Environment
    # The dependencies of the type name resolution of each source of an environment
    #
    # The type names of a source are resolved through the resolver, and they are resolved in the same way as long as the
    # resolver gives the same answers. Recording the type names the resolver was asked, and its answers, with
    # `Environment#resolve_type_names` allows updating a resolved environment incrementally: after some sources are
    # removed from and added to the environment, `#affected_paths` asks the resolver of the new environment again, and
    # tells the other sources whose type names are resolved differently. Only those sources have to be resolved again
    # with the added ones.
    #
    # ```ruby
    # dependencies = RBS::Environment::TypeNameDependencies.new
    # env = env.resolve_type_names(dependencies: dependencies)
    #
    # new_env = env.unload(Set[path])
    # new_env.add_source(source)
    #
    # dependencies.affected_paths(new_env, except: Set[path]).each do |path|
    #   # Replace the source of `path` in `new_env` with the one before the type name resolution
    # end
    #
    # new_env = new_env.resolve_type_names(only: declarations, dependencies: dependencies)
    # ```
    #
    # The keys are the names of the buffers of the sources.
    #
    class TypeNameDependencies
      interface _Empty
        def empty?: () -> bool
      end

      # The type names resolved in each context, and the type names they are resolved to
      #
      # A type name that cannot be resolved is resolved to itself, as `Environment` leaves it in the declaration.
      # The contexts are compared by identity: the declarations of a module share one object, and looking it up doesn't
      # need the hash of the nested array.
      #
      type queries = Hash[Resolver::context, Hash[TypeName, TypeName]]

      # The resolver for the resolution of a source, that records the type names it resolves
      #
      # A type name is resolved once for each context, and `#resolve` returns the type name itself if it cannot be
      # resolved.
      #
      class Recorder
        include Resolver::_TypeNameResolver

        @resolver: Resolver::TypeNameResolver

        attr_reader queries: queries

        def initialize: (Resolver::TypeNameResolver resolver) -> void
      end

      # The type names resolved for each source
      #
      # A source without type names to resolve has no entry.
      #
      attr_reader queries: Hash[Pathname, queries]

      # The namespaces of the wildcard `use` directives of each source, with the type names directly under them
      #
      # The type names a wildcard `use` directive gives are not resolved through the resolver. A source without the
      # directives has no entry.
      #
      attr_reader wildcards: Hash[Pathname, Hash[Namespace, Set[TypeName]]]

      # The class/module aliases each source declares, with the name of the module as it is written and the context
      #
      # The declaration of an alias in a resolved source has the resolved name of the module, that is the answer of
      # the resolver of the environment the source was resolved in. The resolvers read the aliases here instead, to
      # give the same answers as the resolver of an environment that has all of the sources before the resolution.
      # A source without the declarations has no entry.
      #
      attr_reader aliases: Hash[Pathname, Hash[TypeName, [TypeName, Resolver::context]]]

      def initialize: () -> void

      # The copy has its own hashes, and shares the hashes of the sources
      #
      def initialize_copy: (TypeNameDependencies other) -> void

      # Returns the resolver to resolve the sources of `env` that have declarations in `only`, all of them if `only` is `nil`
      #
      # The resolver reads the class/module aliases as they are written. To do so, the dependencies are updated:
      #
      # * The aliases of the sources to resolve are replaced with the ones `env` has, or added if `only` has a part of the declarations of the source
      # * The wildcard `use` directives of the sources to resolve are replaced
      # * The dependencies of the sources that have no declaration, and of the sources `env` doesn't have, are deleted
      #
      def resolver: (Environment env, only: Set[AST::Declarations::t | AST::Ruby::Declarations::t]?) -> Resolver::TypeNameResolver

      # Yields a resolver to resolve the type names of the source with, and records the type names it resolves
      #
      # The type names of the source are replaced, or added to the ones it has if `merge` is `true`.
      #
      # Returns the value of the block.
      #
      def record: [T] (Source::t source, Resolver::TypeNameResolver resolver, merge: bool) { (Resolver::_TypeNameResolver) -> T } -> T

      # Deletes the dependencies of the source
      #
      def delete: (Pathname path) -> void

      # Deletes the dependencies of the sources that are not included in `paths`
      #
      def keep: (Set[Pathname] paths) -> void

      # Returns the paths of the sources whose type names are resolved differently in `env`
      #
      # `env` has the sources after an update of the environment the dependencies were recorded with: `#unload(except)`
      # and `#add_source`. `except` is the paths of the updated sources, that are not included in the result.
      #
      # A source is included if one of the type names it resolved is resolved to another type name in `env`, or the type
      # names directly under the namespace of its wildcard `use` directive are not the same. The former is exact. The
      # latter includes the source even if it doesn't have the added or removed type name.
      #
      def affected_paths: (Environment env, except: Set[Pathname]) -> Set[Pathname]

      private

      # Returns the resolver of the environment, that reads the class/module aliases as they are written
      #
      # The aliases of the sources of `except` are the ones the environment has.
      #
      def build_resolver: (Environment env, ?except: Set[Pathname]?) -> Resolver::TypeNameResolver

      # Returns the type names directly under each of the namespaces
      #
      def children: (Environment env, Array[Namespace] namespaces) -> Hash[Namespace, Set[TypeName]]

      # Returns the namespaces of the wildcard `use` directives of the source
      #
      def wildcard_namespaces: (Source::t source) -> Array[Namespace]

      # Yields the names of the class/module aliases declared in the declaration under the namespace
      #
      def each_alias_name: (AST::Declarations::t | AST::Ruby::Declarations::t decl, Namespace namespace) { (TypeName) -> void } -> void

      # Sets the dependencies of the source, or deletes the entry if the value is empty
      #
      def update: [T < _Empty] (Hash[Pathname, T] hash, Pathname path, T value) -> void
    end
  end
end
